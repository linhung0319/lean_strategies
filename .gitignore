.venv/
__pycache__/
.pytest_cache/
*.pyc

# Backtest output. Regenerated by every run_local.py invocation.
results/

# --- data/ -------------------------------------------------------------
# Split by what the file is, not by where it sits.
#
# OUT: downloaded and converted market data. Regenerable from one convert
# command, and it grows with every symbol and every re-download.
#
# IN:  the reference data mirrored from ../Lean/Data. Small, static, shared
# by every symbol, and hand-topped-up in the case of interest-rate.csv --
# losing that would mean losing the FOMC rows convert appends. Committing it
# also makes an upstream change to the holiday table show up as a diff
# instead of silently altering results.
data/*
!data/market-hours/
!data/symbol-properties/
!data/alternative/
data/alternative/*
!data/alternative/interest-rate/

# Interrupted zip writes. LeanDataWriter renames these into place, so one
# left behind means a crashed run.
*.zip.tmp
*.csv.tmp
